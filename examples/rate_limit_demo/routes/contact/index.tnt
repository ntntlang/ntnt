import { text, status, parse_json, check_limit, too_many_requests } from "std/http/server"
import { split, lower, join } from "std/string"

// Built-in route budget (enforced only when NTNT_RATE_LIMIT=on).
export let rate_post = "5/minute"

// check_limit always works: here, one message per email per hour.
export fn post(req) {
    let data = parse_json(req) otherwise { return status(400, "Send JSON: {\"email\": \"...\"}") }
    let email = data["email"] ?? ""
    let r = check_limit("contact-email:" + mailbox_key(email), "1/hour")
    if !r["allowed"] { return too_many_requests(r) }
    return text("Thanks, " + email)
}

// Domains are case-insensitive; the local part may not be, so keep it as sent.
fn mailbox_key(email) {
    let parts = split(email, "@")
    if len(parts) < 2 { return email }
    let domain = parts[len(parts) - 1]
    let mut local_parts = []
    for i in 0..(len(parts) - 1) { local_parts = push(local_parts, parts[i]) }
    return join(local_parts, "@") + "@" + lower(domain)
}
