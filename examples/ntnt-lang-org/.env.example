# NTNT Language Website - Environment Variables
# Copy this to .env and fill in your values

# =============================================================================
# External Services
# =============================================================================

# Cloudflare Tunnel Token (optional - for public deployment)
# Get this from: https://dash.cloudflare.com → Zero Trust → Networks → Tunnels
# CLOUDFLARE_TUNNEL_TOKEN=your_token_here

# =============================================================================
# Server Mode
# =============================================================================

# Set to "production" or "prod" to disable hot-reload for better performance
# Default: (unset) = development mode with hot-reload enabled
NTNT_ENV=development

# =============================================================================
# Type Checking
# =============================================================================

# Set to "1" or "true" to block execution on type errors
# Default: (unset) = type errors are warnings only
NTNT_STRICT=false

# =============================================================================
# HTTP Server Settings
# =============================================================================

# Override the listen port (useful for testing)
# Default: uses the port specified in server block or listen()
# NTNT_LISTEN_PORT=8080

# Maximum request body size (supports KB, MB, GB suffixes)
# Default: 10MB
NTNT_MAX_BODY_SIZE=10MB

# Enable/disable automatic security headers (X-Content-Type-Options, X-Frame-Options, etc.)
# Default: true
NTNT_SECURITY_HEADERS=true

# Show detailed error messages in responses
# Default: true in development, false in production
NTNT_DETAILED_ERRORS=true

# Request timeout in seconds
# Default: 30
NTNT_TIMEOUT=30

# =============================================================================
# HTTP Client Settings (fetch, cache_fetch)
# =============================================================================

# Enable SSRF (Server-Side Request Forgery) protection
# Default: true in production, false in development
NTNT_SSRF_PROTECTION=false

# Allow requests to localhost (127.0.0.1, ::1, localhost)
# Default: true in development, false in production
NTNT_ALLOW_LOCALHOST=true

# Allow requests to private IP ranges (10.x.x.x, 192.168.x.x, etc.)
# Default: true in development, false in production
NTNT_ALLOW_PRIVATE_IPS=true

# Comma-separated list of blocked hosts
# Default: (empty)
# NTNT_BLOCKED_HOSTS=evil.com,malicious.org
