// Concurrency Demo - Channel-based communication
//
// This demo shows how to use channels for concurrent communication.
// Run with: ./target/release/ntnt run examples/concurrent_demo.tnt
//
// Channels use a two-handle design: channel() returns [tx, rx].
// Pass the sender (tx) to producers; keep the receiver (rx) for consumers.
// When all tx clones drop, recv(rx) automatically returns Unit — no sentinel needed.

import { channel, send, recv, try_recv, recv_timeout, close, sleep_ms, thread_count } from "std/concurrent"

fn main() {
    print("=== NTNT Concurrency Demo ===")
    print("")

    // Check available threads
    let threads = thread_count()
    print("Available CPU threads: " + str(threads))
    print("")

    // Demo 1: Basic channel send/recv
    print("--- Demo 1: Basic Channel ---")
    let [tx1, rx1] = channel()

    send(tx1, "Hello")
    send(tx1, "World")
    send(tx1, 42)
    send(tx1, map { "key": "value", "count": 123 })

    print("Received: " + str(recv(rx1)))
    print("Received: " + str(recv(rx1)))
    print("Received: " + str(recv(rx1)))
    print("Received: " + str(recv(rx1)))

    close(rx1)
    print("")

    // Demo 2: Non-blocking try_recv
    print("--- Demo 2: Non-blocking try_recv ---")
    let [tx2, rx2] = channel()

    // Try to receive from empty channel
    match try_recv(rx2) {
        Some(v) => print("Got: " + str(v)),
        None => print("Channel is empty (expected)")
    }

    send(tx2, "surprise!")
    match try_recv(rx2) {
        Some(v) => print("Got: " + str(v)),
        None => print("Channel is empty")
    }

    close(rx2)
    print("")

    // Demo 3: Timeout receive
    print("--- Demo 3: Timeout Receive ---")
    let [tx3, rx3] = channel()

    print("Waiting for message with 100ms timeout...")
    match recv_timeout(rx3, 100) {
        Some(v) => print("Got: " + str(v)),
        None => print("Timeout! No message received (expected)")
    }

    send(tx3, "fast message")
    print("Waiting for message with 100ms timeout...")
    match recv_timeout(rx3, 100) {
        Some(v) => print("Got: " + str(v)),
        None => print("Timeout!")
    }

    close(rx3)
    print("")

    // Demo 4: Sending complex data structures
    print("--- Demo 4: Complex Data Structures ---")
    let [tx4, rx4] = channel()

    send(tx4, [1, 2, 3, 4, 5])
    send(tx4, map {
        "user": map {
            "name": "Alice",
            "age": 30
        },
        "permissions": ["read", "write", "admin"]
    })
    send(tx4, Ok("Success!"))

    print("Received array: " + str(recv(rx4)))
    print("Received nested map: " + str(recv(rx4)))
    print("Received enum: " + str(recv(rx4)))

    close(rx4)
    print("")

    // Demo 5: Producer/Consumer pattern simulation
    print("--- Demo 5: Producer/Consumer Pattern ---")
    let [work_tx, work_rx] = channel()

    // Produce 5 work items then a done sentinel
    print("Producing 5 work items...")
    for i in 1..=5 {
        let job = map { "job_id": i, "task": "process_item_" + str(i) }
        send(work_tx, job)
    }
    send(work_tx, map { "job_id": -1, "task": "done" })

    // Consume until the done sentinel
    print("Consuming work items...")
    let mut running = true
    while running {
        let item = recv(work_rx)
        if item["job_id"] == -1 {
            print("  Received done signal, stopping")
            running = false
        } else {
            print("  Processing: " + str(item["task"]))
            sleep_ms(50)
        }
    }

    close(work_rx)
    print("")

    print("=== Demo Complete ===")
    print("")
    print("The std/concurrent module provides:")
    print("  - channel()           Create a channel → [TxChannel, RxChannel]")
    print("  - send(tx, val)       Send a value (returns false if receiver closed)")
    print("  - recv(rx)            Receive a value (blocks; returns Unit on disconnect)")
    print("  - try_recv(rx)        Non-blocking receive (returns Option)")
    print("  - recv_timeout(rx, n) Receive with timeout (returns Option)")
    print("  - close(rx)           Close the receiver end")
    print("  - sleep_ms(n)         Sleep for n milliseconds")
    print("  - thread_count()      Get available CPU threads")
}

main()
