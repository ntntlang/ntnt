# Local development only: the throwaway credentials of compose.yml.
# Load into your shell from this directory with `. ./dev.env`.
export NTNT_ENV=development
export NTNT_SECRETS_PROVIDER=env
export APP_DATABASE="host=127.0.0.1 port=55432 user=app_owner dbname=app_development password=dev-only-owner sslmode=disable"
export APP_REPLAY_DATABASE="host=127.0.0.1 port=55432 user=app_replay_owner dbname=app_replay password=dev-only-replay sslmode=disable"
