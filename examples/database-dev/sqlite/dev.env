# Local development only. Load into your shell from this directory with
# `. ./dev.env`. `ntnt db` never creates database files, so this creates an
# empty target and a separate empty scratch file once (an empty file is a valid
# SQLite database) and points the secrets at their absolute paths.
mkdir -p data
[ -e data/app.sqlite ] || : > data/app.sqlite
[ -e data/replay.sqlite ] || : > data/replay.sqlite
export NTNT_ENV=development
export NTNT_SECRETS_PROVIDER=env
export APP_DATABASE_FILE="$PWD/data/app.sqlite"
export APP_REPLAY_FILE="$PWD/data/replay.sqlite"
